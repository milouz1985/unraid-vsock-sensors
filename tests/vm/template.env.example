# Trusted local configuration. Copy to template.env; it is ignored by Git.
# run.sh reads this section from the development workstation.
PVE_HOST=pve01.example.net
PVE_SSH_USER=root
PVE_TEMPLATE_DIR=/root/uvss-template-builder
TEMPLATE_VMID=9000
TEST_VMID=9900
PVE_STORAGE=zfs-pve
GUEST_USER=uvss-test
GUEST_SSH_KEY="${HOME}/.ssh/id_ed25519"
GUEST_SSH_PUBLIC_KEY="${GUEST_SSH_KEY}.pub"
# Optional; defaults to SSH_AUTH_SOCK when set.
GUEST_SSH_IDENTITY_AGENT=""

# build-template.sh reads this section when run directly on Proxmox.
VMID=9000
NAME=uvss-debian13-test-template
STORAGE=zfs-pve
BRIDGE=vmbr0

DEBIAN_VERSION=13
DEBIAN_CODENAME=trixie
# Empty = the running Proxmox host kernel at build/test time.
# Set an exact release (the output of uname -r) to target another PVE kernel.
PVE_KERNEL_RELEASE=""
PVE_KEYRING_FILE=/usr/share/keyrings/proxmox-archive-keyring.gpg
PVE_REPO_COMPONENT=pve-no-subscription
CI_USER=uvss-test
DISK_SIZE=8G
CORES=2
MEMORY=2048
IPCONFIG0="ip=dhcp"
NAMESERVER=""
SEARCHDOMAIN=""
BOOT_TIMEOUT=300
CLOUD_INIT_TIMEOUT=600

# Each run needs an unused VMID. Successful clones are deleted; failures kept.
TEST_TIMEOUT=1800
TEST_DISK_SIZE_GIB=1
# Optionally pin a dated Debian cloud image directory instead of latest:
# IMAGE_BASE_URL=https://cloud.debian.org/images/cloud/trixie/YYYYMMDD-NNNN
