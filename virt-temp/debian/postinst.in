#!/bin/sh
set -e

module="virt-temp"
version="@VERSION@"
service="unraid-vsock-hwmon.service"
kernel_release="$(uname -r)"
config="/etc/default/unraid-vsock-hwmon"
default_config="/usr/share/unraid-vsock-sensors-hwmon/unraid-vsock-hwmon.default"

if [ "$1" != "configure" ]; then
    exit 0
fi

if [ ! -d "/lib/modules/$kernel_release/build" ]; then
    echo "En-têtes absents pour le noyau $kernel_release." >&2
    echo "Installez proxmox-headers-$kernel_release puis exécutez : apt --fix-broken install" >&2
    exit 1
fi

# This file was managed by the former tarball installer and may predate the
# Debian package. Keep it unchanged; create it only for a fresh installation.
if [ ! -e "$config" ]; then
    install -m 0644 "$default_config" "$config"
fi

if ! dkms status -m "$module" -v "$version" 2>/dev/null | grep -Fq "$module/$version"; then
    dkms add -m "$module" -v "$version"
fi
for kernel_build in /lib/modules/*/build; do
    [ -d "$kernel_build" ] || continue
    target_kernel="${kernel_build#/lib/modules/}"
    target_kernel="${target_kernel%/build}"
    dkms build --force -m "$module" -v "$version" -k "$target_kernel"
    dkms install --force -m "$module" -v "$version" -k "$target_kernel"
done

# Migrate installations made by the former tarball installer only after the
# replacement module has built successfully. Its unit in /etc would otherwise
# override the packaged unit in /usr/lib.
if [ -e /usr/local/sbin/uninstall-unraid-vsock-hwmon ]; then
    rm -f -- \
        /etc/modules-load.d/virt-temp.conf \
        /etc/systemd/system/unraid-vsock-hwmon.service \
        /usr/local/bin/unraid-vsock-sensors \
        /usr/local/sbin/uninstall-unraid-vsock-hwmon
fi

systemctl stop "$service" 2>/dev/null || true
if grep -q '^virt_temp ' /proc/modules; then
    modprobe -r virt_temp
fi
modprobe virt_temp
systemctl daemon-reload
systemctl enable --now "$service"

if [ ! -c /dev/virt-temp ]; then
    echo "Le module est chargé, mais /dev/virt-temp reste introuvable." >&2
    exit 1
fi
