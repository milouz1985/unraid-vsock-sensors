[Unit]
Description=Publish Unraid VSOCK temperatures through hwmon
Requires=sys-kernel-config.mount
Wants=unraid-vsock-hwmon-topology.path
After=systemd-modules-load.service sys-kernel-config.mount unraid-vsock-hwmon-topology.path

[Service]
Type=simple
Environment=UNRAID_VSOCK_CID=3
Environment=UNRAID_VSOCK_PORT=990
Environment=UNRAID_VSOCK_CACHE=/var/lib/unraid-vsock-sensors/hwmon-inventory.json
EnvironmentFile=-/etc/default/unraid-vsock-hwmon
# Module loading is the only operation that needs the unrestricted root context.
ExecStartPre=+/usr/sbin/modprobe virt_temp
ExecStart=/usr/bin/unraid-vsock-sensors hwmon --cid ${UNRAID_VSOCK_CID} --port ${UNRAID_VSOCK_PORT} --cache ${UNRAID_VSOCK_CACHE}
Restart=on-failure
RestartSec=2s

CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
# virt_temp appears only after ExecStartPre loads the module.
ReadWritePaths=-/sys/kernel/config/virt_temp
RestrictAddressFamilies=AF_VSOCK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RuntimeDirectory=unraid-vsock-sensors
# Keep topology-changed across stop and restart so its removal never emits a
# false PathChanged event. /run is cleared naturally at boot.
RuntimeDirectoryPreserve=yes
StateDirectory=unraid-vsock-sensors
SystemCallArchitectures=native
SystemCallFilter=~@cpu-emulation @debug @mount @obsolete @privileged @resources

[Install]
WantedBy=multi-user.target
