[Unit]
Description=Publish Unraid VSOCK temperatures through hwmon
Requires=sys-kernel-config.mount
After=systemd-modules-load.service sys-kernel-config.mount

[Service]
Type=simple
Environment=UNRAID_VSOCK_CID=3
Environment=UNRAID_VSOCK_PORT=990
Environment=UNRAID_VSOCK_CACHE=/var/lib/unraid-vsock-sensors/hwmon-inventory.json
Environment=UNRAID_VSOCK_RESTART_UNITS=
EnvironmentFile=-/etc/default/unraid-vsock-hwmon
# Module loading is the only operation that needs the unrestricted root context.
ExecStartPre=+/usr/sbin/modprobe virt_temp
ExecStart=/usr/bin/unraid-vsock-sensors hwmon --cid ${UNRAID_VSOCK_CID} --port ${UNRAID_VSOCK_PORT} --cache ${UNRAID_VSOCK_CACHE} --restart-units=${UNRAID_VSOCK_RESTART_UNITS}
Restart=on-failure
RestartSec=2s

CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
# virt_temp appears only after ExecStartPre loads the module.
ReadWritePaths=-/sys/kernel/config/virt_temp
RestrictAddressFamilies=AF_UNIX AF_VSOCK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
StateDirectory=unraid-vsock-sensors
SystemCallArchitectures=native
SystemCallFilter=~@cpu-emulation @debug @mount @obsolete @privileged @resources

[Install]
WantedBy=multi-user.target
