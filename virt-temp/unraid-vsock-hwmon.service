[Unit]
Description=Publish Unraid VSOCK temperatures through hwmon
After=systemd-modules-load.service

[Service]
Type=simple
Environment=UNRAID_VSOCK_CID=3
Environment=UNRAID_VSOCK_PORT=990
Environment=UNRAID_VSOCK_INTERVAL=1s
Environment=UNRAID_VSOCK_CACHE=/var/lib/unraid-vsock-sensors/hwmon-inventory.json
Environment=UNRAID_VSOCK_SOCKET=/run/unraid-vsock-sensors/sensors.sock
Environment=UNRAID_VSOCK_RESTART_UNITS=
EnvironmentFile=-/etc/default/unraid-vsock-hwmon
ExecStartPre=/usr/sbin/modprobe virt_temp
ExecStart=/usr/bin/unraid-vsock-sensors hwmon --cid ${UNRAID_VSOCK_CID} --port ${UNRAID_VSOCK_PORT} --interval ${UNRAID_VSOCK_INTERVAL} --cache ${UNRAID_VSOCK_CACHE} --socket ${UNRAID_VSOCK_SOCKET} --restart-units=${UNRAID_VSOCK_RESTART_UNITS}
RuntimeDirectory=unraid-vsock-sensors
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
