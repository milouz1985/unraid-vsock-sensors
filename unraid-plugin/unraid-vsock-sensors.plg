<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "unraid-vsock-sensors">
<!ENTITY author "François HOYEZ">
<!ENTITY version "2.0.0">
<!ENTITY pluginURL "https://raw.githubusercontent.com/milouz1985/unraid-vsock-sensors/main/unraid-plugin/unraid-vsock-sensors.plg">
<!ENTITY package "unraid-vsock-sensors-2.0.0-x86_64-1.txz">
<!ENTITY packageURL "https://github.com/milouz1985/unraid-vsock-sensors/releases/download/v2.0.0/unraid-vsock-sensors-2.0.0-x86_64-1.txz">
<!ENTITY packageMD5 "298fcb63198b8e2531207b45890be1c5">
<!ENTITY packageSHA256 "26d762563d80b56ca5154ce2119e00890786f75e57bd20a452094ec8e601654c">
<!ENTITY cfgdir "/boot/config/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;"
        pluginURL="&pluginURL;" launch="Settings/UnraidVsockSensors"
        support="https://github.com/milouz1985/unraid-vsock-sensors/issues"
        project="https://github.com/milouz1985/unraid-vsock-sensors"
        min="6.12.0" icon="icon.png">
<DESCRIPTION>
Pushes disk temperatures from Unraid's disks.ini and devs.ini, and HBA
temperatures over AF_VSOCK to Proxmox as native hwmon sensors.
</DESCRIPTION>
<CHANGES>
### 2.0.0 - 2026-09-13

- Push persistent disk and HBA snapshots over VSOCK to Proxmox hwmon sensors, with saved topology and a stale-data failsafe.
- Read temp and spundown from Unraid's disks.ini and devs.ini, and exclude USB disks by physical bus.
- Add per-disk Auto, Include and Exclude policies with UI validation and reset.
- Use backend-specific HBA polling defaults: 15 seconds for mpt3ctl and 30 seconds for StorCLI.

### 1.4.3 - 2026-08-31

- Package the VSOCK disk and HBA temperature server as an Unraid plugin.
- Add service controls, status, version, VSOCK port and HBA settings to the Unraid UI.
</CHANGES>

<FILE Name="&cfgdir;/&package;" Run="/sbin/upgradepkg --install-new --reinstall">
<URL>&packageURL;</URL>
<MD5>&packageMD5;</MD5>
<SHA256>&packageSHA256;</SHA256>
</FILE>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
set -e
name="unraid-vsock-sensors"
cfgdir="/boot/config/plugins/$name"
mkdir -p "$cfgdir"
find "$cfgdir" -maxdepth 1 -name "$name-*.txz" ! -name "unraid-vsock-sensors-2.0.0-x86_64-1.txz" -delete 2>/dev/null || true
if [[ ! -f "$cfgdir/$name.cfg" ]]; then
    install -m 0644 "/usr/local/emhttp/plugins/$name/default.cfg" "$cfgdir/$name.cfg"
fi
chmod 0755 "/etc/rc.d/rc.$name"
"/etc/rc.d/rc.$name" restart
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
name="unraid-vsock-sensors"
cfgdir="/boot/config/plugins/$name"
"/etc/rc.d/rc.$name" stop 2>/dev/null || true
/sbin/removepkg "$name" >/dev/null 2>&1 || true
rm -f "$cfgdir"/$name-*.txz
echo "Configuration preserved in $cfgdir"
]]></INLINE>
</FILE>
</PLUGIN>
