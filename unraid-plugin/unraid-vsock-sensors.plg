<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "unraid-vsock-sensors">
<!ENTITY author "François HOYEZ">
<!ENTITY version "0.2.1-dev.21.gbaf6a352689b">
<!ENTITY pluginURL "https://git.lan.home/francois/unraid-vsock-sensors/raw/branch/main/unraid-plugin/unraid-vsock-sensors.plg">
<!ENTITY package "unraid-vsock-sensors-0.2.1_dev.21.gbaf6a352689b-x86_64-1.txz">
<!ENTITY packageURL "https://git.lan.home/francois/unraid-vsock-sensors/releases/download/v0.2.1-dev.21.gbaf6a352689b/unraid-vsock-sensors-0.2.1_dev.21.gbaf6a352689b-x86_64-1.txz">
<!ENTITY packageMD5 "ba960d663a489a28f26e40662655b28c">
<!ENTITY packageSHA256 "6b662d2049af5e51f8eb00d136844154da14279bf947d277221b4722502527f3">
<!ENTITY cfgdir "/boot/config/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;"
        pluginURL="&pluginURL;" launch="Settings/UnraidVsockSensors"
        min="6.12.0" icon="refresh">
<DESCRIPTION>
Exposes cached Unraid disk and HBA temperatures over AF_VSOCK to Proxmox
guests and the CoolerControl plugin without waking sleeping disks.
</DESCRIPTION>
<CHANGES>
### &version;

- Package the VSOCK sensor server as an Unraid plugin.
- Add service status, version, start, stop, restart, port and StorCLI cache settings.
</CHANGES>

<FILE Name="&cfgdir;/&package;" Run="/sbin/upgradepkg --install-new --reinstall">
<URL>&packageURL;</URL>
<MD5>&packageMD5;</MD5>
<SHA256>&packageSHA256;</SHA256>
</FILE>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
set -e
name="unraid-vsock-sensors"
cfgdir="/boot/config/plugins/$name"
mkdir -p "$cfgdir"
find "$cfgdir" -maxdepth 1 -name "$name-*.txz" ! -name "unraid-vsock-sensors-0.2.1_dev.21.gbaf6a352689b-x86_64-1.txz" -delete 2>/dev/null || true
if [[ ! -f "$cfgdir/$name.cfg" ]]; then
    install -m 0644 "/usr/local/emhttp/plugins/$name/default.cfg" "$cfgdir/$name.cfg"
fi
chmod 0755 "/etc/rc.d/rc.$name"
"/etc/rc.d/rc.$name" restart
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
name="unraid-vsock-sensors"
cfgdir="/boot/config/plugins/$name"
"/etc/rc.d/rc.$name" stop 2>/dev/null || true
/sbin/removepkg "$name" >/dev/null 2>&1 || true
rm -f "$cfgdir/$name.cfg" "$cfgdir"/$name-*.txz
rmdir "$cfgdir" 2>/dev/null || true
]]></INLINE>
</FILE>
</PLUGIN>
