<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "unraid-vsock-sensors">
<!ENTITY author "François HOYEZ">
<!ENTITY version "1.6.0-dev.93.g014daa42ac93">
<!ENTITY pluginURL "https://raw.githubusercontent.com/milouz1985/unraid-vsock-sensors/main/unraid-plugin/unraid-vsock-sensors.plg">
<!ENTITY package "unraid-vsock-sensors-1.6.0_dev.93.g014daa42ac93-x86_64-1.txz">
<!ENTITY packageURL "https://github.com/milouz1985/unraid-vsock-sensors/releases/download/v1.6.0-dev.93.g014daa42ac93/unraid-vsock-sensors-1.6.0_dev.93.g014daa42ac93-x86_64-1.txz">
<!ENTITY packageMD5 "10db4344e626bbd2cc0c364a0466d427">
<!ENTITY packageSHA256 "5df3155b6a64bdeb9e5b5c04950ccf1bf8d40dcaaea7cdb7dbbd79fac500f2ea">
<!ENTITY cfgdir "/boot/config/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;"
        pluginURL="&pluginURL;" launch="Settings/UnraidVsockSensors"
        min="6.12.0" icon="icon.png">
<DESCRIPTION>
Pushes Unraid disk and HBA temperatures over AF_VSOCK to the Proxmox host and
the CoolerControl plugin without querying sleeping disks.
</DESCRIPTION>
<CHANGES>
### &version;

- Package the VSOCK sensor publisher as an Unraid plugin.
- Add service status, version, start, stop, restart, port and HBA cache settings.
</CHANGES>

<FILE Name="&cfgdir;/&package;" Run="/sbin/upgradepkg --install-new --reinstall">
<URL>&packageURL;</URL>
<MD5>&packageMD5;</MD5>
<SHA256>&packageSHA256;</SHA256>
</FILE>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
set -e
name="unraid-vsock-sensors"
cfgdir="/boot/config/plugins/$name"
mkdir -p "$cfgdir"
find "$cfgdir" -maxdepth 1 -name "$name-*.txz" ! -name "unraid-vsock-sensors-1.6.0_dev.93.g014daa42ac93-x86_64-1.txz" -delete 2>/dev/null || true
if [[ ! -f "$cfgdir/$name.cfg" ]]; then
    install -m 0644 "/usr/local/emhttp/plugins/$name/default.cfg" "$cfgdir/$name.cfg"
fi
chmod 0755 "/etc/rc.d/rc.$name"
"/etc/rc.d/rc.$name" restart
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
name="unraid-vsock-sensors"
cfgdir="/boot/config/plugins/$name"
"/etc/rc.d/rc.$name" stop 2>/dev/null || true
/sbin/removepkg "$name" >/dev/null 2>&1 || true
rm -f "$cfgdir/$name.cfg" "$cfgdir"/$name-*.txz
rmdir "$cfgdir" 2>/dev/null || true
]]></INLINE>
</FILE>
</PLUGIN>
