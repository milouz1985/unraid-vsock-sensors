<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "unraid-vsock-sensors">
<!ENTITY author "François HOYEZ">
<!ENTITY version "@VERSION@">
<!ENTITY pluginURL "@PLUGIN_URL@">
<!ENTITY package "@PACKAGE_NAME@">
<!ENTITY packageURL "@PACKAGE_URL@">
<!ENTITY packageMD5 "@PACKAGE_MD5@">
<!ENTITY packageSHA256 "@PACKAGE_SHA256@">
<!ENTITY cfgdir "/boot/config/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;"
        pluginURL="&pluginURL;" launch="Settings/UnraidVsockSensors"
        support="https://github.com/milouz1985/unraid-vsock-sensors/issues"
        project="https://github.com/milouz1985/unraid-vsock-sensors"
        min="6.12.0" icon="icon.png">
<DESCRIPTION>
Pushes disk temperatures from Unraid's disks.ini and devs.ini, and HBA
temperatures over AF_VSOCK to Proxmox as native hwmon sensors.
</DESCRIPTION>
<CHANGES>
### 2.1.0 - 2026-09-19

- Add a read-only Diagnostics page that displays the daemon's runtime state: VSOCK link, emhttpd polling and fallback, per-disk thermal status and HBA readings.
- Keep invalid disks visible in the management inventory so they can be identified and excluded without blocking policy management.
- Keep the last valid poll_attributes and disk policies in effect when a transient read or parse error occurs, so a temporary failure no longer drops the effective configuration.
- Report a stale control-socket shutdown when an accepted policy mutation is still in flight after the stop deadline.
- Preserve the Unraid configuration on plugin removal, and harden the control API request decoding (bounded bodies, rejection of non-scalar fields).

### 2.0.0 - 2026-09-13

- Push persistent disk and HBA snapshots over VSOCK to Proxmox hwmon sensors, with saved topology and a stale-data failsafe.
- Read temp and spundown from Unraid's disks.ini and devs.ini, and exclude USB disks by physical bus.
- Add per-disk Auto, Include and Exclude policies with UI validation and reset.
- Use fixed backend-specific HBA polling intervals: 15 seconds for mpt3ctl and 30 seconds for StorCLI.

### 1.4.3 - 2026-08-31

- Package the VSOCK disk and HBA temperature server as an Unraid plugin.
- Add service controls, status, version, VSOCK port and HBA settings to the Unraid UI.
</CHANGES>

<FILE Name="&cfgdir;/&package;" Run="/sbin/upgradepkg --install-new --reinstall">
<URL>&packageURL;</URL>
<MD5>&packageMD5;</MD5>
<SHA256>&packageSHA256;</SHA256>
</FILE>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
set -e
name="unraid-vsock-sensors"
cfgdir="/boot/config/plugins/$name"
mkdir -p "$cfgdir"
find "$cfgdir" -maxdepth 1 -name "$name-*.txz" ! -name "@PACKAGE_NAME@" -delete 2>/dev/null || true
if [[ ! -f "$cfgdir/$name.cfg" ]]; then
    install -m 0644 "/usr/local/emhttp/plugins/$name/default.cfg" "$cfgdir/$name.cfg"
fi
chmod 0755 "/etc/rc.d/rc.$name"
"/etc/rc.d/rc.$name" restart
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
name="unraid-vsock-sensors"
cfgdir="/boot/config/plugins/$name"
"/etc/rc.d/rc.$name" stop 2>/dev/null || true
/sbin/removepkg "$name" >/dev/null 2>&1 || true
rm -f "$cfgdir"/$name-*.txz
echo "Configuration preserved in $cfgdir"
]]></INLINE>
</FILE>
</PLUGIN>
