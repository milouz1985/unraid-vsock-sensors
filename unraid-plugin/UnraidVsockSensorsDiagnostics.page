<?php
// This page only reads the daemon's local CLI snapshot; it never collects data.
function uvssDiagEsc($value): string {
    return htmlspecialchars((string)($value ?? '—'), ENT_QUOTES, 'UTF-8');
}
function uvssDiagAge($seconds): string {
    if ($seconds === null) return '—';
    $seconds = max(0, (int)$seconds);
    if ($seconds < 60) return $seconds . 's ago';
    if ($seconds < 3600) return intdiv($seconds, 60) . 'm ago';
    return intdiv($seconds, 3600) . 'h ago';
}
function uvssDiagState($state): string {
    $state = (string)$state;
    if (in_array($state, ['running', 'connected', 'healthy', 'valid'], true)) {
        $class = 'green';
    } elseif (in_array($state, ['stale', 'reconnecting', 'retained', 'standby', 'waking', 'unknown', 'unknown/config error'], true)) {
        $class = 'orange';
    } elseif (in_array($state, ['disabled', 'polling disabled'], true)) {
        $class = 'gray';
    } else {
        $class = 'red';
    }
    return '<span class="uvssdiag-status ' . $class . '">' . uvssDiagEsc(ucfirst($state)) . '</span>';
}
$lines = [];
exec('/usr/local/sbin/unraid-vsock-sensors diagnostics 2>&1', $lines, $status);
$diagnostics = $status === 0 ? json_decode(implode("\n", $lines), true) : null;
$error = $status === 0 ? '' : trim(implode("\n", $lines));
if ($status === 0 && !is_array($diagnostics)) $error = 'Invalid diagnostics JSON';
?>

<style>
.uvssdiag-status.green { color: #21844a; }
.uvssdiag-status.orange { color: #b66a00; }
.uvssdiag-status.red { color: #c53434; }
.uvssdiag-status.gray { color: #777; }
</style>

<p><a href="/Settings/UnraidVsockSensors">Back to Unraid VSOCK Sensors</a> · <a href="/Settings/UnraidVsockSensorsDiagnostics">Refresh page</a></p>

<?php if (!is_array($diagnostics)): ?>
<h3>Diagnostics unavailable</h3>
<p class="red"><?=uvssDiagEsc($error !== '' ? $error : 'No daemon diagnostics available')?></p>
<p>Start the service from the main plugin page, or check its log if the daemon is already running.</p>
<?php else:
$vsock = $diagnostics['vsock'] ?? [];
$emhttpd = $diagnostics['emhttpd'] ?? [];
$disks = $diagnostics['disks'] ?? [];
$hba = $diagnostics['hba'] ?? [];
$config = $diagnostics['config'] ?? [];
?>

<h3>Overall status</h3>
<table><thead><tr><th>Component</th><th>Status</th><th>Details</th></tr></thead><tbody>
<tr><td>Service</td><td><?=uvssDiagState($diagnostics['service'] ?? 'error')?></td><td>PID <?=uvssDiagEsc($diagnostics['pid'] ?? null)?> · v<?=uvssDiagEsc($diagnostics['version'] ?? null)?> · uptime <?=uvssDiagEsc($diagnostics['uptime_seconds'] ?? null)?>s · started <?=uvssDiagEsc($diagnostics['started_at'] ?? null)?></td></tr>
<tr><td>VSOCK</td><td><?=uvssDiagState($vsock['status'] ?? 'error')?></td><td>Last successful publish: <?=uvssDiagEsc(uvssDiagAge($vsock['last_published_age_seconds'] ?? null))?></td></tr>
<tr><td>emhttpd SMART</td><td><?=uvssDiagState($emhttpd['status'] ?? 'error')?></td><td><?=uvssDiagEsc($emhttpd['temperature_source'] ?? null)?></td></tr>
<tr><td>Disk collector</td><td><?=uvssDiagState($disks['status'] ?? 'error')?></td><td><?=uvssDiagEsc($disks['error'] ?? '')?></td></tr>
<tr><td>HBA collector</td><td><?=uvssDiagState($hba['status'] ?? 'error')?></td><td><?=uvssDiagEsc($hba['last_error'] ?? '')?></td></tr>
</tbody></table>

