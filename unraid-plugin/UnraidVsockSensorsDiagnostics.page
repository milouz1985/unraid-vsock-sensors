<?php if (!empty($hba['items'])): ?>
<table><thead><tr><th>ID</th><th>Model</th><th>PCI address</th><th>Temperature</th></tr></thead><tbody>
<?php foreach ($hba['items'] as $controller): ?><tr><td><?=uvssDiagEsc($controller['id'] ?? null)?></td><td><?=uvssDiagEsc($controller['model'] ?? null)?></td><td><?=uvssDiagEsc($controller['pci_address'] ?? null)?></td><td><?=uvssDiagEsc($controller['temp_c'] ?? null)?> °C</td></tr><?php endforeach; ?>
</tbody></table>
