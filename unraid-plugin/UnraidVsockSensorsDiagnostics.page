<?php if (!empty($vsock['last_error'])): ?><p class="red">VSOCK publisher: <?=uvssDiagEsc($vsock['last_error'])?> (<?=uvssDiagEsc($vsock['last_error_at'] ?? null)?>)</p><?php endif; ?>

<?php endif; ?>
