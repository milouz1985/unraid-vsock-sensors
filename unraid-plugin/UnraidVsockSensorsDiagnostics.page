<h3>Disks</h3>
<p>Last valid observation is when UVSS accepted a temperature, not when the disk was physically measured. Disk IDs may contain serial numbers; redact them before sharing this page or the diagnostics JSON file.</p>
<?php if (!empty($disks['policy_error'])): ?><p class="red">Disk policies: <?=uvssDiagEsc($disks['policy_error'])?></p><?php endif; ?>
<?php if (empty($disks['items'])): ?><p>No disk readings available.</p><?php else: ?>
<div class="TableContainer">
<table><thead><tr><th>Name</th><th>Unraid ID</th><th>Device</th><th>Transport</th><th>Rotational</th><th>Temperature</th><th>Status</th><th>Last valid source</th><th>Last valid observation</th></tr></thead><tbody>
<?php foreach ($disks['items'] as $disk): ?>
<tr><td><?=uvssDiagEsc($disk['name'] ?? null)?></td><td><?=uvssDiagEsc($disk['id'] ?? null)?></td><td><?=uvssDiagEsc($disk['device'] ?? null)?></td><td><?=uvssDiagEsc($disk['transport'] ?? null)?></td><td><?=!empty($disk['rotational']) ? 'Yes' : 'No'?></td><td><?=isset($disk['temperature_c']) ? uvssDiagEsc($disk['temperature_c']) . ' °C' : '—'?></td><td><?=uvssDiagState($disk['status'] ?? 'error')?><?php if (!empty($disk['error'])): ?>: <?=uvssDiagEsc($disk['error'])?><?php endif; ?></td><td><?=uvssDiagEsc($disk['source'] ?? null)?></td><td><?=uvssDiagEsc(uvssDiagAge($disk['last_valid_age_seconds'] ?? null))?></td></tr>
<?php endforeach; ?>
</tbody></table>
</div>
<?php endif; ?>

