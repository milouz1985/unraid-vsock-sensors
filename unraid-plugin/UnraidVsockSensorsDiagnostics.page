<?php
// This page reads the daemon's JSON runtime snapshot directly; it never collects data.
function uvssDiagEsc($value): string {
    return htmlspecialchars((string)($value ?? '—'), ENT_QUOTES, 'UTF-8');
}
function uvssDiagAge($seconds): string {
    if ($seconds === null) return '—';
    $seconds = max(0, (int)$seconds);
    if ($seconds < 60) return $seconds . 's ago';
    if ($seconds < 3600) return intdiv($seconds, 60) . 'm ago';
    return intdiv($seconds, 3600) . 'h ago';
}
function uvssDiagState($state): string {
    $state = (string)$state;
    if (in_array($state, ['running', 'connected', 'healthy', 'valid'], true)) {
        $class = 'green';
    } elseif (in_array($state, ['stale', 'reconnecting', 'retained', 'standby', 'waking', 'unknown', 'unknown/config error'], true)) {
        $class = 'orange';
    } elseif (in_array($state, ['disabled', 'polling disabled'], true)) {
        $class = 'gray';
    } else {
        $class = 'red';
    }
    return '<span class="uvssdiag-status ' . $class . '">' . uvssDiagEsc(ucfirst($state)) . '</span>';
}
$diagnosticsPath = '/run/unraid-vsock-sensors/diagnostics.json';
$diagnostics = null;
$error = '';
$data = @file_get_contents($diagnosticsPath);
if ($data === false) {
    $error = 'Daemon stopped: diagnostics state is absent or unreadable';
} else {
    $decoded = json_decode($data, true);
    if (!is_array($decoded)
        || (int)($decoded['schema_version'] ?? 0) !== 2
        || (int)($decoded['pid'] ?? 0) <= 0
        || empty($decoded['version'])
        || empty($decoded['generated_at'])
        || empty($decoded['started_at'])) {
        $error = 'Invalid diagnostics state';
    } else {
        $pid = (int)$decoded['pid'];
        $generatedAt = strtotime((string)$decoded['generated_at']);
        $startedAt = strtotime((string)$decoded['started_at']);
        $now = time();
        $cmdline = @file_get_contents('/proc/' . $pid . '/cmdline');
        $argv = $cmdline === false ? [] : explode("\0", rtrim($cmdline, "\0"));
        if (count($argv) < 2
            || $argv[0] !== '/usr/local/sbin/unraid-vsock-sensors'
            || $argv[1] !== 'serve') {
            $error = 'Daemon stopped: diagnostics state does not belong to the running service';
        } elseif ($generatedAt === false || $startedAt === false) {
            $error = 'Invalid diagnostics timestamps';
        } elseif (($now - $generatedAt) > 5 || $generatedAt > ($now + 1)) {
            $error = 'Diagnostic state is stale: daemon has not updated its runtime snapshot';
        } else {
            $diagnostics = $decoded;
        }
    }
}
?>

<style>
.uvssdiag-status.green { color: var(--green-800, #21844a); }
.uvssdiag-status.orange { color: var(--orange-300, #b66a00); }
.uvssdiag-status.red { color: var(--red-600, #c53434); }
.uvssdiag-status.gray { color: var(--alt-text-color, #777); }
</style>

<p><a href="/Settings/UnraidVsockSensors">Back to Unraid VSOCK Sensors</a> · <a href="/Settings/UnraidVsockSensorsDiagnostics">Refresh page</a></p>

