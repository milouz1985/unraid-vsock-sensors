<p>Mode: <?=uvssDiagEsc($hba['mode'] ?? null)?> · Backend: <?=uvssDiagEsc($hba['backend'] ?? null)?> · Interval: <?=uvssDiagEsc($hba['interval'] ?? null)?> · Controllers: <?=uvssDiagEsc($hba['count'] ?? null)?> · Last successful collection: <?=uvssDiagEsc($hba['last_successful_at'] ?? null)?> (<?=uvssDiagEsc(uvssDiagAge($hba['snapshot_age_seconds'] ?? null))?>)</p>
