<h3>Diagnostics unavailable</h3>
<p class="red"><?=uvssDiagEsc($error !== '' ? $error : 'No daemon diagnostics available')?></p>
<p>Start the service from the main plugin page, or check its log if the daemon is already running.</p>
<?php else:
$vsock = $diagnostics['vsock'] ?? [];
$emhttpd = $diagnostics['emhttpd'] ?? [];
$disks = $diagnostics['disks'] ?? [];
$hba = $diagnostics['hba'] ?? [];
?>

