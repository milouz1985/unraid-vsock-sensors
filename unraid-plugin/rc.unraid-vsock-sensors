#!/bin/bash

name="unraid-vsock-sensors"
binary="${UVSS_RC_BINARY:-/usr/local/sbin/$name}"
config="${UVSS_RC_CONFIG:-/boot/config/plugins/$name/$name.cfg}"
pid_file="${UVSS_RC_PID_FILE:-/var/run/$name.pid}"
lock_file="${UVSS_RC_LOCK_FILE:-/var/run/$name.lock}"

close_inherited_fds() {
    local descriptor path
    for path in /proc/self/fd/*; do
        descriptor="${path##*/}"
        if [[ "$descriptor" =~ ^[0-9]+$ ]] && (( descriptor > 2 )); then
            eval "exec ${descriptor}>&-"
        fi
    done
}

load_config() {
    PORT="990"
    HBA_MODE="enabled"
    HBA_BACKEND="mpt3ctl"
    HBA_INTERVAL="15s"

    if [[ -r "$config" ]]; then
        local line key value line_number=0
        while IFS= read -r line || [[ -n "$line" ]]; do
            ((line_number++))
            line="${line%$'\r'}"
            [[ -z "$line" ]] && continue

            # update.php writes KEY="value". Parse that format as data: sourcing
            # this file would execute shell syntax embedded in a crafted value.
            if [[ "$line" =~ ^(PORT|HBA_MODE|HBA_BACKEND|HBA_INTERVAL)=\"([^\"]*)\"$ ]]; then
                key="${BASH_REMATCH[1]}"
                value="${BASH_REMATCH[2]}"
                printf -v "$key" '%s' "$value"
            else
                echo "Invalid configuration at $config:$line_number" >&2
                return 1
            fi
        done < "$config"
    fi

    if [[ ! "$PORT" =~ ^[0-9]+$ ]] || (( 10#$PORT < 1 || 10#$PORT > 4294967294 )); then
        echo "Invalid VSOCK port: $PORT" >&2
        return 1
    fi
    case "$HBA_MODE" in
        enabled|disabled) ;;
        *) echo "Invalid HBA mode: $HBA_MODE" >&2; return 1 ;;
    esac
    case "$HBA_BACKEND" in
        mpt3ctl)
            case "$HBA_INTERVAL" in
                10s|15s|30s|1m) ;;
                *) echo "Invalid mpt3ctl refresh interval: $HBA_INTERVAL" >&2; return 1 ;;
            esac
            ;;
        storcli)
            case "$HBA_INTERVAL" in
                30s|1m|5m) ;;
                *) echo "Invalid StorCLI refresh interval: $HBA_INTERVAL" >&2; return 1 ;;
            esac
            ;;
        *) echo "Invalid HBA backend: $HBA_BACKEND" >&2; return 1 ;;
    esac
}

running_pid() {
    [[ -r "$pid_file" ]] || return 1
    local pid executable
    read -r pid < "$pid_file"
    [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1

    # A stale PID file may refer to an unrelated process after PID reuse. Check
    # argv[0] rather than /proc/PID/exe because package upgrades may replace the
    # executable while the old service is still running.
    IFS= read -r -d '' executable < "/proc/$pid/cmdline" || return 1
    [[ "$executable" == "$binary" ]] || return 1
    printf '%s\n' "$pid"
}

start() {
    local pid running
    if pid="$(running_pid)"; then
        echo "$name is already running (PID $pid)"
        return 0
    fi
    rm -f "$pid_file"
    load_config || return 1
    if [[ ! -x "$binary" ]]; then
        echo "Missing executable: $binary" >&2
        return 1
    fi

    # Plugin Manager invokes this script with private pipes and extra file
    # descriptors. Detach completely before exec so the long-lived daemon can
    # never keep an install or update operation pending.
    (
        close_inherited_fds
        exec nohup "$binary" serve --port "$PORT" --hba-mode "$HBA_MODE" \
            --hba-backend "$HBA_BACKEND" --hba-interval "$HBA_INTERVAL" --syslog
    ) </dev/null >/dev/null 2>&1 &
    pid=$!
    if ! printf '%s\n' "$pid" > "$pid_file"; then
        echo "Unable to write PID file: $pid_file" >&2
        kill "$pid" 2>/dev/null || true
        return 1
    fi
    sleep 1
    if ! running="$(running_pid)" || [[ "$running" != "$pid" ]]; then
        kill "$pid" 2>/dev/null || true
        rm -f "$pid_file"
        echo "$name failed to start; see /var/log/syslog (tag $name)" >&2
        return 1
    fi
    echo "$name started (PID $pid)"
}

stop() {
    local pid running
    if ! pid="$(running_pid)"; then
        rm -f "$pid_file"
        echo "$name is not running"
        return 0
    fi

    kill -TERM "$pid" 2>/dev/null || true
    for _ in {1..50}; do
        if ! running="$(running_pid)" || [[ "$running" != "$pid" ]]; then
            rm -f "$pid_file"
            echo "$name stopped"
            return 0
        fi
        sleep 0.1
    done

    # Revalidate the PID before sending an uncatchable signal: the daemon may
    # have exited just after the last poll and its PID may have been reused.
    if ! running="$(running_pid)" || [[ "$running" != "$pid" ]]; then
        rm -f "$pid_file"
        echo "$name stopped"
        return 0
    fi

    echo "$name did not stop within 5 seconds; sending SIGKILL" >&2
    kill -KILL "$pid" 2>/dev/null || true
    for _ in {1..10}; do
        if ! running="$(running_pid)" || [[ "$running" != "$pid" ]]; then
            rm -f "$pid_file"
            echo "$name stopped after SIGKILL"
            return 0
        fi
        sleep 0.1
    done
    echo "$name is still present after SIGKILL" >&2
    return 1
}

status() {
    local pid
    if pid="$(running_pid)"; then
        echo "running (PID $pid)"
        return 0
    fi
    echo "stopped"
    return 3
}

refresh() {
    local pid
    if ! pid="$(running_pid)"; then
        echo "$name is not running"
        return 0
    fi
    if ! kill -USR1 "$pid" 2>/dev/null; then
        echo "Unable to refresh $name (PID $pid)" >&2
        return 1
    fi
    echo "$name refresh requested"
}

run_mutating_action() {
    local action="$1" lock_fd

    if ! exec {lock_fd}>"$lock_file"; then
        echo "Unable to open service lock: $lock_file" >&2
        return 1
    fi
    if ! flock -x "$lock_fd"; then
        echo "Unable to lock service operations: $lock_file" >&2
        return 1
    fi

    case "$action" in
        start) start ;;
        stop) stop ;;
        restart) stop && start ;;
    esac
}

case "${1:-}" in
    start|stop|restart) run_mutating_action "$1" ;;
    status) status ;;
    refresh) refresh ;;
    *) echo "Usage: $0 {start|stop|restart|status|refresh}" >&2; exit 2 ;;
esac
