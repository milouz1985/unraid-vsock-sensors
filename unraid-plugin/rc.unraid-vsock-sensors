#!/bin/bash

name="unraid-vsock-sensors"
binary="/usr/local/sbin/$name"
config="/boot/config/plugins/$name/$name.cfg"
pid_file="/var/run/$name.pid"
log_file="/var/log/$name.log"

load_config() {
    PORT="990"
    HBA_MODE="enabled"
    HBA_BACKEND="auto"
    MPT3CTL_INTERVAL="15s"
    STORCLI_INTERVAL="30s"

    if [[ -r "$config" ]]; then
        local line key value line_number=0
        while IFS= read -r line || [[ -n "$line" ]]; do
            ((line_number++))
            line="${line%$'\r'}"
            [[ -z "$line" ]] && continue

            # update.php writes KEY="value". Parse that format as data: sourcing
            # this file would execute shell syntax embedded in a crafted value.
            if [[ "$line" =~ ^(PORT|HBA_MODE|HBA_BACKEND|MPT3CTL_INTERVAL|STORCLI_INTERVAL|HBA_INTERVAL)=\"([^\"]*)\"$ ]]; then
                key="${BASH_REMATCH[1]}"
                value="${BASH_REMATCH[2]}"
                if [[ "$key" == "HBA_INTERVAL" ]]; then
                    # Preserve the former generic interval as the conservative
                    # StorCLI/automatic interval during upgrades.
                    STORCLI_INTERVAL="$value"
                else
                    printf -v "$key" '%s' "$value"
                fi
            else
                echo "Invalid configuration at $config:$line_number" >&2
                return 1
            fi
        done < "$config"
    fi

    if [[ ! "$PORT" =~ ^[0-9]+$ ]] || (( 10#$PORT < 1 || 10#$PORT > 4294967294 )); then
        echo "Invalid VSOCK port: $PORT" >&2
        return 1
    fi
    case "$MPT3CTL_INTERVAL" in
        10s|15s|30s|1m) ;;
        *) echo "Invalid mpt3ctl refresh interval: $MPT3CTL_INTERVAL" >&2; return 1 ;;
    esac
    case "$STORCLI_INTERVAL" in
        30s|1m|5m) ;;
        *) echo "Invalid StorCLI refresh interval: $STORCLI_INTERVAL" >&2; return 1 ;;
    esac
    case "$HBA_MODE" in
        enabled|disabled) ;;
        auto) HBA_MODE="enabled" ;;
        *) echo "Invalid HBA mode: $HBA_MODE" >&2; return 1 ;;
    esac
    case "$HBA_BACKEND" in
        mpt3ctl) HBA_INTERVAL="$MPT3CTL_INTERVAL" ;;
        storcli|auto) HBA_INTERVAL="$STORCLI_INTERVAL" ;;
        *) echo "Invalid HBA backend: $HBA_BACKEND" >&2; return 1 ;;
    esac
}

running_pid() {
    [[ -r "$pid_file" ]] || return 1
    local pid executable
    read -r pid < "$pid_file"
    [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1

    # A stale PID file may refer to an unrelated process after PID reuse. Check
    # argv[0] rather than /proc/PID/exe because package upgrades may replace the
    # executable while the old service is still running.
    IFS= read -r -d '' executable < "/proc/$pid/cmdline" || return 1
    [[ "$executable" == "$binary" ]] || return 1
    printf '%s\n' "$pid"
}

start() {
    local pid
    if pid="$(running_pid)"; then
        echo "$name is already running (PID $pid)"
        return 0
    fi
    rm -f "$pid_file"
    load_config || return 1
    if [[ ! -x "$binary" ]]; then
        echo "Missing executable: $binary" >&2
        return 1
    fi

    nohup "$binary" serve --port "$PORT" --hba-mode "$HBA_MODE" --hba-backend "$HBA_BACKEND" \
        --hba-interval "$HBA_INTERVAL" \
        </dev/null >>"$log_file" 2>&1 &
    pid=$!
    printf '%s\n' "$pid" > "$pid_file"
    sleep 1
    if ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$pid_file"
        echo "$name failed to start; see $log_file" >&2
        return 1
    fi
    echo "$name started (PID $pid)"
}

stop() {
    local pid
    if ! pid="$(running_pid)"; then
        rm -f "$pid_file"
        echo "$name is not running"
        return 0
    fi

    kill "$pid"
    for _ in {1..50}; do
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$pid_file"
            echo "$name stopped"
            return 0
        fi
        sleep 0.1
    done
    echo "$name did not stop within 5 seconds" >&2
    return 1
}

status() {
    local pid
    if pid="$(running_pid)"; then
        echo "running (PID $pid)"
        return 0
    fi
    echo "stopped"
    return 3
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop && start ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
