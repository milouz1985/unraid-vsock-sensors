### Service

_(Status)_:
: <span class="<?=$running ? 'green' : 'red'?>"><?=htmlspecialchars($status, ENT_QUOTES)?></span>

_(Version)_:
: <?=htmlspecialchars($version, ENT_QUOTES)?>

<form markdown="1" method="POST" action="/update.php" target="progressFrame">
<input type="hidden" name="#command" value="/plugins/unraid-vsock-sensors/service.sh">

_(Actions)_:
: <span class="uvss-actions"><?php if ($running): ?><button class="uvss-action" type="submit" name="#arg[1]" value="stop">_(Stop)_</button><button class="uvss-action" type="submit" name="#arg[1]" value="restart">_(Restart)_</button><?php else: ?><button class="uvss-action" type="submit" name="#arg[1]" value="start">_(Start)_</button><?php endif; ?></span>
</form>

### Configuration

<form markdown="1" method="POST" action="/update.php" target="progressFrame">
<input type="hidden" name="#file" value="unraid-vsock-sensors/unraid-vsock-sensors.cfg">
<input type="hidden" name="#command" value="/plugins/unraid-vsock-sensors/service.sh">
<input type="hidden" name="#arg[1]" value="restart">

_(VSOCK port)_:
: <input type="number" name="PORT" value="<?=$port?>" min="1" max="4294967294" required>

> The Proxmox client and the CoolerControl plugin must use the same port.

_(Disk SMART refresh interval)_:
: <select name="DISK_INTERVAL">
<option value="30s" <?=$diskInterval === '30s' ? 'selected' : ''?>>30 seconds</option>
<option value="1m" <?=$diskInterval === '1m' ? 'selected' : ''?>>1 minute</option>
<option value="2m" <?=$diskInterval === '2m' ? 'selected' : ''?>>2 minutes</option>
<option value="5m" <?=$diskInterval === '5m' ? 'selected' : ''?>>5 minutes</option>
</select>

> Active disks are collected in the background. Sleeping disks are not queried. VSOCK requests always use the cached value.

_(HBA monitoring)_:
: <select name="HBA_MODE">
<option value="enabled" <?=$hbaMode === 'enabled' ? 'selected' : ''?>>Enabled</option>
<option value="disabled" <?=$hbaMode === 'disabled' ? 'selected' : ''?>>Disabled</option>
</select>

> Enabled uses the backend selected below. Disabled explicitly clears the HBA inventory when the host agent restarts.

_(HBA backend)_:
: <select id="hba-backend" name="HBA_BACKEND">
<option value="mpt3ctl" <?=$hbaBackend === 'mpt3ctl' ? 'selected' : ''?>>Native /dev/mpt3ctl</option>
<option value="storcli" <?=$hbaBackend === 'storcli' ? 'selected' : ''?>>StorCLI</option>
</select>

> The native backend requires an mpt3sas controller and /dev/mpt3ctl. The StorCLI backend requires the StorCLI package or the [storcli64 Unraid plugin](https://forums.unraid.net/topic/192112-plugin-storcli64/) to be installed.

> The mpt3ctl backend is experimental. It follows the upstream Linux mpt3sas implementation and is used in production by the project author, but has not yet been validated across a broad range of controllers and firmware versions.

_(HBA refresh interval)_:
: <select id="hba-interval" name="HBA_INTERVAL" data-current="<?=htmlspecialchars($hbaInterval, ENT_QUOTES)?>">
</select>

> Native access offers shorter intervals than StorCLI. VSOCK requests always use the cached value.

&nbsp;

: <input type="submit" value="_(Apply)_">
</form>

<script>
(function () {
    const backend = document.getElementById('hba-backend');
    const interval = document.getElementById('hba-interval');
    const choices = {
        mpt3ctl: [['10s', '10 seconds'], ['15s', '15 seconds'], ['30s', '30 seconds'], ['1m', '1 minute']],
        storcli: [['30s', '30 seconds'], ['1m', '1 minute'], ['5m', '5 minutes']]
    };

    function refreshIntervals(keepCurrent) {
        const previous = keepCurrent ? interval.dataset.current : interval.value;
        const values = choices[backend.value];
        interval.replaceChildren();
        for (const [value, label] of values) {
            const option = new Option(label, value);
            option.selected = value === previous;
            interval.add(option);
        }
        if (!values.some(([value]) => value === previous)) {
            interval.value = backend.value === 'mpt3ctl' ? '15s' : '30s';
        }
        interval.dataset.current = interval.value;
    }

    backend.addEventListener('change', function () { refreshIntervals(false); });
    refreshIntervals(true);
}());
</script>
