<script>
(function () {
    const backend = document.getElementById('hba-backend');
    const interval = document.getElementById('hba-interval');
    const intervalWarning = document.getElementById('hba-interval-warning');

    const choices = {
        mpt3ctl: [
            ['10s', '10 seconds'],
            ['15s', '15 seconds'],
            ['30s', '30 seconds'],
            ['1m', '1 minute']
        ],
        storcli: [
            ['30s', '30 seconds'],
            ['1m', '1 minute'],
            ['5m', '5 minutes']
        ]
    };

    const defaults = {
        mpt3ctl: '15 seconds',
        storcli: '30 seconds'
    };

    const rememberedIntervals = {};
    let activeBackend = backend.value;

    rememberedIntervals[activeBackend] = interval.dataset.current;

    function refreshIntervals(previous, warnUnsupported) {
        const values = choices[backend.value];

        interval.replaceChildren();
        interval.add(
            new Option(
                'Default (' + defaults[backend.value] + ')',
                ''
            )
        );

        for (const [value, label] of values) {
            interval.add(new Option(label, value));
        }

        const supported =
            previous === '' ||
            values.some(([value]) => value === previous);

        interval.value = supported ? previous : '';

        intervalWarning.hidden = supported || !warnUnsupported;

        if (!supported && warnUnsupported) {
            intervalWarning.textContent =
                previous +
                ' is not available with ' +
                backend.value +
                '. Default (' +
                defaults[backend.value] +
                ') is selected; apply to save this change.';
        }

        rememberedIntervals[backend.value] = interval.value;
    }

    backend.addEventListener('change', function () {
        const previous = interval.value;

        rememberedIntervals[activeBackend] = previous;
        activeBackend = backend.value;

        const hasRememberedValue =
            Object.prototype.hasOwnProperty.call(
                rememberedIntervals,
                activeBackend
            );

        refreshIntervals(
            hasRememberedValue
                ? rememberedIntervals[activeBackend]
                : previous,
            !hasRememberedValue
        );
    });

    interval.addEventListener('change', function () {
        rememberedIntervals[activeBackend] = interval.value;
        intervalWarning.hidden = true;
    });

    refreshIntervals(interval.dataset.current, true);

    document.querySelectorAll('.uvss-control-form').forEach(function (form) {
        form.addEventListener('submit', async function (event) {
            event.preventDefault();
            const button = form.querySelector('button[type="submit"]');
            if (button) button.disabled = true;
            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    credentials: 'same-origin'
                });
                const payload = await response.json().catch(function () { return {}; });
                if (!response.ok || payload.ok !== true) {
                    throw new Error(payload.error || 'Disk policy update failed');
                }
                window.location.reload();
            } catch (error) {
                alert(error.message || String(error));
                if (button) button.disabled = false;
            }
        });
    });
}());
</script>
