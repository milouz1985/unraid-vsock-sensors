<?php
// The control helper is installed next to this page under the emhttp plugin
// directory. Resolve it from the Unraid document root (the page lives in
// /usr/local/emhttp/plugins/unraid-vsock-sensors) rather than a hard-coded
// filesystem path.
$uvssDocRoot = $_SERVER['DOCUMENT_ROOT'] ?: '/usr/local/emhttp';
$uvssControlHelper = $uvssDocRoot . '/plugins/unraid-vsock-sensors/uvss_control.php';
if (!is_file($uvssControlHelper)) {
    $uvssControlHelper = __DIR__ . '/uvss_control.php';
}
require_once $uvssControlHelper;
$plugin = 'unraid-vsock-sensors';
$cfg = parse_plugin_cfg($plugin);
$unraidState = @parse_ini_file('/var/local/emhttp/var.ini');
$csrfToken = is_array($unraidState) ? (string)($unraidState['csrf_token'] ?? '') : '';

$port = htmlspecialchars($cfg['PORT'] ?? '990', ENT_QUOTES);
$hbaMode = $cfg['HBA_MODE'] ?? 'enabled';
$hbaBackend = $cfg['HBA_BACKEND'] ?? 'mpt3ctl';
$hbaInterval = $cfg['HBA_INTERVAL'] ?? '';

$statusOutput = [];
exec('/etc/rc.d/rc.unraid-vsock-sensors status 2>/dev/null', $statusOutput, $statusCode);
$running = $statusCode === 0;
$status = $running ? implode(' ', $statusOutput) : 'stopped';

$version = trim((string)shell_exec('/usr/local/sbin/unraid-vsock-sensors version 2>/dev/null'));
if ($version === '') {
    $version = 'unavailable';
}

$pollRaw = is_array($unraidState) ? ($unraidState['poll_attributes'] ?? null) : null;
$pollValid = is_string($pollRaw) && preg_match('/^\d+$/', $pollRaw) === 1;
$pollAttributes = $pollValid
    ? filter_var($pollRaw, FILTER_VALIDATE_INT, ['options' => ['min_range' => 0]])
    : false;
$pollValid = $pollValid && $pollAttributes !== false;

if (!$pollValid) {
    $pollDisplay = 'Unavailable (daemon keeps the last valid interval, or 30 seconds until the first valid read)';
} elseif ($pollAttributes === 0) {
    $pollDisplay = 'Disabled';
} else {
    $pollDisplay = $pollAttributes . ($pollAttributes === 1 ? ' second' : ' seconds');
}

// Disk inventory and policy state are read from the daemon control socket; no
// UVSS process is spawned for a page load. The helper returns a homogeneous
// envelope. States mapped to the UI:
//   - ok                              -> show the inventory (data=[] is valid)
//   - daemon / transport              -> daemon unreachable
//   - api with HTTP 422               -> invalid disk-policies.json, offer reset
//   - api with HTTP 500 / protocol    -> inventory / control API error, no reset
$diskListResult = uvss_control_list_disks();
$diskRows = ($diskListResult['ok'] ?? false) === true ? ($diskListResult['data'] ?? []) : [];
$diskListState = 'ok';            // ok | daemon | transport | invalid | error
$diskListError = '';
if (($diskListResult['ok'] ?? false) !== true) {
    $kind = $diskListResult['kind'] ?? 'daemon';
    $httpStatus = (int)($diskListResult['http_status'] ?? 0);
    $diskListError = $diskListResult['error'] ?? '';
    if ($kind === 'api' && $httpStatus === 422) {
        $diskListState = 'invalid';
    } elseif ($kind === 'api' || $kind === 'protocol') {
        $diskListState = 'error';
    } else {
        $diskListState = $kind;    // daemon | transport
    }
}
$diskPoliciesInvalid = $diskListState === 'invalid';
?>

