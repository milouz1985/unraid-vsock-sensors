Menu="OtherSettings"
Title="Unraid VSOCK Sensors"
Icon="icon.png"
---
<?php
$plugin = 'unraid-vsock-sensors';
$cfg = parse_plugin_cfg($plugin);
$port = htmlspecialchars($cfg['PORT'] ?? '990', ENT_QUOTES);
$diskInterval = $cfg['DISK_INTERVAL'] ?? '30s';
$hbaMode = $cfg['HBA_MODE'] ?? 'enabled';
if ($hbaMode === 'auto') {
    $hbaMode = 'enabled';
}
$hbaBackend = $cfg['HBA_BACKEND'] ?? 'mpt3ctl';
$hbaInterval = $cfg['HBA_INTERVAL'] ?? ($hbaBackend === 'storcli' ? '30s' : '15s');

$statusOutput = [];
exec('/etc/rc.d/rc.unraid-vsock-sensors status 2>/dev/null', $statusOutput, $statusCode);
$running = $statusCode === 0;
$status = $running ? implode(' ', $statusOutput) : 'stopped';
$version = trim((string)shell_exec('/usr/local/sbin/unraid-vsock-sensors version 2>/dev/null'));
if ($version === '') {
    $version = 'unavailable';
}
?>

<style>
.uvss-actions {
